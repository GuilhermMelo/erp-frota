# Copie para backend/.env e ajuste.
# Gere a chave com:  python -c "import secrets; print(secrets.token_urlsafe(32))"

ENV=dev
SECRET_KEY=dev-secret-troque-em-producao
ACCESS_TOKEN_EXPIRE_MINUTES=480

DATABASE_URL=postgresql+psycopg://frota:frota@localhost:5434/frota

# Pasta onde os arquivos (fotos, contratos, notas) são gravados
STORAGE_DIR=../storage

CORS_ORIGINS=http://localhost:5273

# Usuário admin criado no primeiro boot.
# ADMIN_PASSWORD vazio = a senha é SORTEADA e gravada em
#   %LOCALAPPDATA%\GM Locacoes\senha-inicial-admin.txt
# Deixe vazio. Preencher aqui só faz sentido em ambiente de teste automatizado, onde a
# suíte precisa saber a senha de antemão.
ADMIN_EMAIL=admin@erpfrota.com.br
ADMIN_PASSWORD=
ADMIN_NAME=Administrador

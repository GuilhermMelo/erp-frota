# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/

# Node
node_modules/
dist/
dist-ssr/
*.local

# Ambiente
.env
.env.*
!.env.example

# Arquivos enviados pelo usuário (fotos, contratos, notas fiscais)
storage/

# Cópias de segurança. Contêm CPF, CNH e contratos — dado pessoal (LGPD).
# Elas nascem em %LOCALAPPDATA%; esta linha é a rede de proteção caso alguém
# aponte o backup para dentro do projeto.
backups/
*.dump

# Log do backend (em dev o run_server.py grava na raiz do projeto)
logs/

# Editor / SO
.DS_Store
Thumbs.db
*.log

# Empacotamento
backend/build/
backend/dist/
desktop/dist/
# A interface compilada que a API serve. Gerada por `npm run build` — é artefato, não fonte.
backend/static/

# Postgres portátil embutido no app (baixado uma vez; ~120 MB, não versionar)
desktop/vendor/

# Configuração local do editor
.vscode/

# Grafo de conhecimento do graphify (derivado do código; regerável com `graphify update .`)
graphify-out/

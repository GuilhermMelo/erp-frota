{
  "name": "gm-locacoes-desktop",
  "version": "1.0.0",
  "description": "GM Locações — gestão de frota",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "br.com.gmlocacoes.erp",
    "productName": "GM Locações",
    "copyright": "Guilherme Melo",
    "files": ["main.js", "loading.html", "icon.png"],
    "extraResources": [
      {
        "from": "../backend/dist/erp-frota-api",
        "to": "backend"
      },
      {
        "from": "../docker-compose.yml",
        "to": "docker-compose.yml"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "GM Locações"
    }
  }
}
